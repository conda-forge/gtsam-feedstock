METIS' initial partitioning draws from the platform libc RNG, so on macOS the
two islands come back with their labels (or their A/B roles) swapped relative
to Linux. Both answers describe the same partition, so canonicalize the
labelling in the test rather than hard-coding one platform's arbitrary choice.
(testFindSeparator already did this for edgePartitionByMetis at line 93.)

--- a/gtsam_unstable/partition/tests/testFindSeparator.cpp
+++ b/gtsam_unstable/partition/tests/testFindSeparator.cpp
@@ -15,6 +15,29 @@
 using namespace gtsam;
 using namespace gtsam::partition;
 
+namespace {
+// METIS' initial partitioning draws from the platform libc RNG, so the two
+// islands can come back with their labels (or their A/B roles) swapped. Both
+// answers describe the same partition, so canonicalize before comparing.
+void canonicalize(partition::PartitionTable& table) {
+  for (const int label : table) {
+    if (label == 1) return;  // already canonical
+    if (label == 2) break;   // islands are swapped
+  }
+  for (int& label : table) {
+    if (label == 1)
+      label = 2;
+    else if (label == 2)
+      label = 1;
+  }
+}
+
+void canonicalize(MetisResult& result) {
+  if (!result.A.empty() && !result.B.empty() && result.A.front() > result.B.front())
+    result.A.swap(result.B);
+}
+}  // namespace
+
 /* ************************************************************************* */
 // x0 - x1 - x2
 // l3        l4
